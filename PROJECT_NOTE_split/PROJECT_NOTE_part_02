### 4. Отношение к сквозным переменным

Mission определяет **ОТНОШЕНИЕ** агента к ключевым переменным:

```python
@dataclass
class CrossCuttingAttitude:
    """
    Отношение агента к сквозным переменным.
    
    Это калибруется MISSION, не оптимизируется.
    """
    
    # === ДЕНЬГИ ===
    # Как агент относится к деньгам?
    money_importance: float           # 0.0 - 1.0
    money_threshold_high: float       # С какой суммы деньги "важны"
    money_threshold_low: float        # Ниже этой суммы — не интересно
    money_urgency_multiplier: float   # Умножитель важности при нехватке
    
    # === ВРЕМЯ ===
    # Как агент относится к времени?
    time_importance: float            # 0.0 - 1.0
    time_horizon_preference: TimeHorizon  # short / medium / long
    time_penalty_per_hour: float      # Штраф за час сверх дедлайна
    
    # === РЕПУТАЦИЯ ===
    # Как агент относится к репутации?
    reputation_importance: float      # 0.0 - 1.0
    reputation_threshold: float       # Минимальный приемлемый рейтинг
    reputation_boost_per_task: float  # Сколько рейтинга даёт успешная задача
    
    # === ОБУЧЕНИЕ ===
    # Как агент относится к обучению?
    learning_importance: float        # 0.0 - 1.0
    learning_preference: LearningType # task_related / general / any
    learning_max_cost: float           # Максимум ресурсов на обучение
    
    # === РИСК ===
    # Как агент относится к риску?
    risk_tolerance: float             # 0.0 - 1.0
    risk_budget: float                # Сколько можно потерять
    risk_aversity_threshold: float    # Выше этого — отказ без обсуждений


class TimeHorizon(Enum):
    SHORT = "short"       # < 1 week
    MEDIUM = "medium"     # 1 week - 1 month
    LONG = "long"          # > 1 month


class LearningType(Enum):
    TASK_RELATED = "task_related"  # Только то, что поможет в текущей задаче
    GENERAL = "general"             # Общее развитие
    ANY = "any"                     # Любое обучение


def calibrate_cross_cutting(
    mission: MissionProfile,
    state: AgentState
) -> CrossCuttingAttitude:
    """
    Калибрует отношение к сквозным переменным.
    """
    
    # === ДЕНЬГИ ===
    # Survival миссия = высокая важность денег
    if mission.mission_type == MissionType.SURVIVAL:
        money_importance = 0.9
        money_urgency = 1.5
    elif mission.mission_type == MissionType.PREMIUM:
        money_importance = 0.3
        money_urgency = 1.0
    else:
        money_importance = 0.5
        money_urgency = 1.0
    
    # Модификация на основе состояния
    if state.C_spent > state.B_total * 0.8:
        money_urgency *= 1.3
    
    # === ВРЕМЯ ===
    # Impatient personality = высокая важность времени
    time_importance = {
        "patient": 0.3,
        "balanced_t": 0.6,
        "impatient": 0.9,
    }[mission.personality.time_attitude]
    
    # === РЕПУТАЦИЯ ===
    reputation_importance = {
        MissionType.PREMIUM: 0.8,
        MissionType.MAINTENANCE: 0.6,
        MissionType.GROWTH: 0.4,
        MissionType.SURVIVAL: 0.2,
        MissionType.MAXIMIZE: 0.5,
        MissionType.CHARITY: 0.3,
    }[mission.mission_type]
    
    # === ОБУЧЕНИЕ ===
    learning_importance = {
        MissionType.GROWTH: 0.8,
        MissionType.CHARITY: 0.5,
        MissionType.MAINTENANCE: 0.3,
        MissionType.MAXIMIZE: 0.4,
        MissionType.SURVIVAL: 0.1,
        MissionType.PREMIUM: 0.2,
    }[mission.mission_type]
    
    # === РИСК ===
    risk_tolerance = {
        "conservative": 0.2,
        "moderate": 0.5,
        "aggressive": 0.8,
    }[mission.personality.risk_profile]
    
    # Модификация на основе состояния
    if state.Φ_historical < 0:
        risk_tolerance *= 1.2  # Готовы рисковать в убытке
    elif state.Φ_historical > state.B_total * 0.5:
        risk_tolerance *= 0.8  # Осторожнее когда есть прибыль
    
    return CrossCuttingAttitude(
        money_importance=money_importance,
        money_threshold_high=state.B_total * 0.8,
        money_threshold_low=state.B_total * 0.05,
        money_urgency_multiplier=money_urgency,
        
        time_importance=time_importance,
        time_horizon_preference=TimeHorizon.MEDIUM,
        time_penalty_per_hour=10.0,  # $ за час
        
        reputation_importance=reputation_importance,
        reputation_threshold=3.5,
        reputation_boost_per_task=0.05,
        
        learning_importance=learning_importance,
        learning_preference=LearningType.TASK_RELATED,
        learning_max_cost=state.B_total * 0.1,
        
        risk_tolerance=risk_tolerance,
        risk_budget=state.B_total * 0.3,
        risk_aversity_threshold=state.B_total * 0.5,
    )
