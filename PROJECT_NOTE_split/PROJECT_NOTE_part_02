### 2. Архитектура Mission

```python
@dataclass
class MissionProfile:
    """
    Профиль миссии агента.
    
    Это metadata — не вычисляется, а задаётся при инициализации
    или изменяется через explicit reconfiguration.
    """
    
    # === ИДЕНТИЧНОСТЬ ===
    identity: IdentityProfile
    
    # === ПРИНЦИПЫ (в порядке приоритета) ===
    principles: List[Principle]
    
    # === ТИП МИССИИ ===
    mission_type: MissionType
    
    # === ТИП ЛИЧНОСТИ (влияет на calibration) ===
    personality: PersonalityProfile


@dataclass
class IdentityProfile:
    """Кто я такой — базовая идентичность агента."""
    
    name: str                              # "Freelancer Agent", "Enterprise Assistant"
    role: str                              # "Code Reviewer", "Data Analyst"
    expertise: List[str]                   # ["Python", "ML", "Kubernetes"]
    
    # Сколько у меня "кожи в игре"?
    # - personal: моя личная репутация
    # - client: я представляю клиента
    # - platform: я часть платформы
    ownership: Literal["personal", "client", "platform"]


@dataclass
class Principle:
    """Принцип — правило, которое агент НЕ нарушает."""
    
    name: str
    description: str
    
    # Приоритет: critical > high > medium > low
    priority: Literal["critical", "high", "medium", "low"]
    
    # Это hard constraint (Γ_rules) или soft preference?
    is_hard: bool
    
    # Примеры:
    # - "Не навреди" (critical, hard) — Γ_rule
    # - "Используй открытые инструменты" (medium, soft)
    # - "Работай быстро" (low, soft)


class MissionType(Enum):
    """
    Тип миссии определяет базовую калибровку.
    Это отправная точка, не абсолют.
    """
    
    # === SURVIVAL — Выживание ===
    # Агент в критическом состоянии, нужны деньги любой ценой
    # → λ_profit = 0.8, risk_tolerance = 0.9, quality_flexible = True
    SURVIVAL = "survival"
    
    # === GROWTH — Рост ===
    # Агент набирает опыт, готов инвестировать в обучение
    # → λ_evolution = 0.5, λ_profit = 0.3, risk_tolerance = 0.6
    GROWTH = "growth"
    
    # === MAINTENANCE — Поддержка ===
    # Агент в стабильном состоянии, поддерживает уровень
    # → λ_reputation = 0.4, λ_profit = 0.3, λ_evolution = 0.2
    MAINTENANCE = "maintenance"
    
    # === MAXIMIZE — Максимизация ===
    # Агент работает на пределе возможностей
    # → λ_profit = 0.5, λ_evolution = 0.3, risk_tolerance = 0.7
    MAXIMIZE = "maximize"
    
    # === PREMIUM — Премиум ===
    # Агент работает с VIP-клиентами, качество критично
    # → q_min = 0.9, λ_reputation = 0.5, λ_profit = 0.2
    PREMIUM = "premium"
    
    # === CHARITY — Благотворительность ===
    # Агент работает бесплатно или почти бесплатно
    # → λ_profit = 0.1, λ_evolution = 0.4, risk_tolerance = 0.8
    CHARITY = "charity"


@dataclass
class PersonalityProfile:
    """Личностные черты — влияют на калибровку."""
    
    # === ОТНОШЕНИЕ К РИСКУ ===
    # conservative: избегаю рисков, даже если это стоит денег
    # moderate: баланс риска и вознаграждения
    # aggressive: готов рисковать ради выгоды
    risk_profile: Literal["conservative", "moderate", "aggressive"]
    
    # === ОТНОШЕНИЕ К ДЕНЬГАМ ===
    # frugal: каждая копейка на счету
    # balanced: разумная экономия
    # generous: готов потратить для качества
    money_attitude: Literal["frugal", "balanced", "generous"]
    
    # === ОТНОШЕНИЕ К ВРЕМЕНИ ===
    # patient: могу подождать ради лучшего результата
    # balanced_t: разумный баланс
    # impatient: скорость важнее
    time_attitude: Literal["patient", "balanced_t", "impatient"]
    
    # === ОТНОШЕНИЕ К КАЧЕСТВУ ===
    # perfectionist: максимальное качество любой ценой
    # standard: достаточное качество
    # pragmatic: "good enough" подход
    quality_attitude: Literal["perfectionist", "standard", "pragmatic"]
