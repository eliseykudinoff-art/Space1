class SpikeSignal:
    """
    Спайковый сигнал (как в нервной системе)
    
    Наши триггеры генерируют спайки:
    - Trigger fires → Spike emitted
    - Spike propagates to action systems
    - Spike decays over time
    """
    
    spike_type: SpikeType
    intensity: float        # 0.0 - 1.0
    timestamp: datetime
    decay_rate: float      # как быстро затухает
    
    def propagate(self, target_system: str):
        """
        Распространение спайка к целевой системе
        """
        if self.intensity > target_system.threshold:
            target_system.receive_spike(self)
    
    def decay(self):
        """
        Затухание спайка
        """
        self.intensity *= (1.0 - self.decay_rate)
