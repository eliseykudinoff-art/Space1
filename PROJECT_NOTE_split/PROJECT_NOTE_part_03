    Отслеживает provenance цепочку всех решений.
    """
    
    def record(self, event: DecisionEvent):
        """
        Записывает каждое решение с полным контекстом.
        """
        self.chain.append({
            "timestamp": now(),
            "mission_snapshot": copy(self.current_mission),
            "state_snapshot": copy(self.agent_state),
            "decision": event.decision,
            "reasoning": event.reasoning,
            "outcome": None,  # Заполняется позже
        })
    
    def detect_mission_drift(self) -> bool:
        """
        Сравнивает начальный mission с текущим поведением.
        """
        initial = self.chain[0]["mission_snapshot"]
        recent_actions = self.chain[-100:]  # Последние 100 действий
        
        # Проверяем отклонение
        drift_score = self.compute_drift(initial, recent_actions)
        
        return drift_score > self.drift_threshold
```

#### 2.3 Inverse Reward Design (IRD)

**Reference:** [14] Inverse Reward Design — Hadfield-Menell & Russell

```python
class InverseRewardDesigner:
    """
    IRD: трактуем proxy reward как evidence о настоящей награде.
    
    Основная идея:
    - Дизайнер дал нам proxy reward
    - Это reward из proxy environment (не настоящего)
    - Нужно восстановить uncertainty о настоящей reward
    - Plan risk-averse с учётом этой uncertainty
    """
    
    def plan_with_ird(
        self,
        proxy_reward: RewardFunction,
        training_env: Environment,
        actual_env: Environment
    ) -> Plan:
        """
        Планирование с учётом reward uncertainty.
        """
        # Шаг 1: Инfer reward posterior
        # P(R_true | R_proxy, env_proxy) 
        reward_posterior = self.infer_reward_posterior(
            proxy_reward,
            training_env
        )
        
        # Шаг 2: Risk-averse planning
        # Вместо max R_proxy, ищем план который хорош
        # для всех R в posterior с высокой вероятностью
        return self.robust_optimize(
            reward_posterior=reward_posterior,
            planning_algorithm=self.mcts,
            risk_measure="CVaR"
        )
```

